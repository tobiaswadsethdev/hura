{
  "model": "opus[1m]",
  "permissions": {
    "defaultMode": "auto"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "hura-usage"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "hura-status idle" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "hura-status running" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "hura-status running" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "hura-status running" }]
      }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "hura-status waiting" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "hura-status idle" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "hura-status idle" }] }
    ]
  }
}
