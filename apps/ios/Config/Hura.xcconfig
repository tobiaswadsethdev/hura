// Signing for the App Store and TestFlight. To build under another team (for
// a fork, say), override these in Config/Signing.local.xcconfig, which git
// ignores:
//
//   HURA_BUNDLE_ID = com.yourname.hura
//   HURA_TEAM_ID = ABCDE12345

HURA_BUNDLE_ID = dev.tobiaswadseth.hura.ios
HURA_TEAM_ID = 5CLNYT78JN

// The push relay (relay/README.md), as a host name: xcconfig treats // as a
// comment, so no https://. Empty builds an app without notifications.
HURA_RELAY_HOST = hura-relay.twadseth.workers.dev

#include? "Signing.local.xcconfig"
